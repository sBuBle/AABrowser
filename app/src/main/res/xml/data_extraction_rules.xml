<?xml version="1.0" encoding="utf-8"?><!--
   Nothing leaves the device through backups or device-to-device transfer. Besides settings, the
   app's private storage holds WebView cookies, site storage and HTTP cache (app_webview), which
   carry live sign-in sessions; restoring them on another device would hand those sessions over.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
